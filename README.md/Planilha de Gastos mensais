salario = float(input("Digite o seu salário mensal: R$ "))

total_despesas = 0

while True:
    descricao = input("Digite a descrição da despesa (ou 'sair' para encerrar): ")

    if descricao.lower() == 'sair':
        break

    valor = float(input(f"Digite o valor da despesa '{descricao}': R$ "))
    total_despesas += valor

print("")
print("---- RESUMO ----")
print(f"Salário mensal: R$ {salario:.2f}")
print(f"Total de despesas: R$ {total_despesas:.2f}")

diferenca = salario - total_despesas

if diferenca > 0:
    print(f"Você está no azul! Sobra R$ {diferenca:.2f}.")
elif diferenca == 0:
    print("Atenção! Você está no limite do seu orçamento.")
else:
    print(f"Você está no vermelho! Faltam R$ {abs(diferenca):.2f} para cobrir as despesas.")
